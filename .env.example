# Public production origin used by canonical links, robots.txt, and sitemap.xml.
SITE_URL=https://your-project.vercel.app

# GA4 measurement ID. This value is public and is embedded in the browser bundle.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Content value from the Google Search Console HTML meta-tag verification method.
GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
